generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookStatus {
  PUBLISHED
  SOLD
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  books     Book[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Book {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  price       Float
  author      String
  status      BookStatus @default(PUBLISHED)
  soldAt      DateTime?
  ownerId     Int
  owner       User       @relation(fields: [ownerId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}
