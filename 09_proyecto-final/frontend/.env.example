# URL del API tal como la ve el navegador (incluye el prefijo /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# URL del WebSocket (privado en /ws?token=, público en /ws/public/{slug})
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
# Origen público del frontend, para metadatos, sitemap y hreflang
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# true: todo va contra los mocks (MSW) y el WebSocket simulado; false: contra el API real
NEXT_PUBLIC_API_MOCKING=false
# URL del API para las consultas que hace el servidor de Next (SSR). Dentro de Compose apunta al servicio api
API_URL_INTERNAL=http://api:8000/api/v1
